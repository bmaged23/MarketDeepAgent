# LLM — Ollama Cloud
LLM_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=https://ollama.com

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# Storage and retrieval
DATABASE_PATH=data/products.db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=market_products
EMBEDDING_DEVICE=cpu
INDEXING_POLL_SECONDS=2

# Required for product administration (X-Admin-Key header)
ADMIN_API_KEY=

# Hybrid score fusion: normalize each result list to [0, 1], then combine
SEARCH_FUSION_METHOD=weighted_sum
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
BM25_CANDIDATES=50
VECTOR_CANDIDATES=50
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=100
RRF_K=60

# Timeouts and embedding execution
QDRANT_TIMEOUT_SECONDS=10
OLLAMA_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=data/model_cache

# Indexing execution
INDEXING_BATCH_SIZE=100
INDEXING_MAX_RETRY_SECONDS=300


# Retrieval agent: Ollama planning, batch relevance and coverage
OLLAMA_TEMPERATURE=0
RETRIEVAL_MAX_ROUNDS=3
RETRIEVAL_MAX_SEARCHES=8
RETRIEVAL_QUERIES_PER_ROUND=3
RETRIEVAL_RESULTS_PER_QUERY=3
RETRIEVAL_JSON_RETRIES=1

# Cart and customer coordinator
CART_QUOTE_TTL_SECONDS=900
CART_MAX_ITEMS=100
CART_JSON_RETRIES=1
CUSTOMER_JSON_RETRIES=1
CUSTOMER_HISTORY_MESSAGES=20

CURRENCY=USD

# Authentication, conversation and per-user memory
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
MEMORY_COLLECTION=customer_memories
MEMORY_RECALL_TOP_K=5
MEMORY_MIN_SCORE=0.4
MEMORY_MAX_RECORDS=200
MEMORY_PROPOSALS_PER_TURN=3
MEMORY_SYNC_BATCH_SIZE=3
CONVERSATION_SUMMARY_CHARS=2000
CHAT_TURN_LOCK_SECONDS=1800

# Maximum rows per structured SQL retrieval page (hybrid top_k remains separate)
RETRIEVAL_SQL_MAX_RESULTS=100
RETRIEVAL_RELEVANCE_BATCH_SIZE=100

# Number of cart lines included in factual chat receipts
CUSTOMER_RECEIPT_MAX_ITEMS=10
